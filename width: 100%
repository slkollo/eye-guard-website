        // Auto-detect browser language
        function detectLanguage() {
            const browserLang = navigator.language || navigator.userLanguage;
            const langCode = browserLang.split('-')[0].toLowerCase();
            
            // Map of language codes
            const langMap = {
                'en': 'en',
                'ko': 'ko',
                'zh': 'zh',
                'ja': 'ja',
                'es': 'es',
                'fr': 'fr',
                'de': 'de',
                'ar': 'ar',
                'hi': 'hi',
                'si': 'si'
            };
            
            return langMap[langCode] || 'en'; // Default to English
        }

        // Change language function
        function changeLanguage(lang) {
            const trans = translations[lang];
            if (!trans) return;
            
            // Update current language display
            document.getElementById('currentLang').textContent = trans.currentLang;
            
            // Update all translatable elements
            document.querySelectorAll('[data-translate]').forEach(element => {
                const key = element.getAttribute('data-translate');
                if (trans[key]) {
                    element.textContent = trans[key];
                }
            });
            
            // Update HTML content elements
            const heroTitle = document.querySelector('.hero-content h1');
            if (heroTitle) heroTitle.innerHTML = trans.hero_title;
            
            const heroDesc = document.querySelector('.hero-content p');
            if (heroDesc) heroDesc.textContent = trans.hero_description;
            
            const problemTitle = document.querySelector('.problem-content h2');
            if (problemTitle) problemTitle.innerHTML = trans.problem_title;
            
            const problemDesc = document.querySelector('.problem-content p');
            if (problemDesc) problemDesc.textContent = trans.problem_description;
            
            // Update badges
            const badges = document.querySelectorAll('.badge');
            if (badges[0]) badges[0].innerHTML = `<i class="fas fa-check-circle"></i> ${trans.badge_privacy}`;
            if (badges[1]) badges[1].innerHTML = `<i class="fas fa-globe"></i> ${trans.badge_languages}`;
            if (badges[2]) badges[2].innerHTML = `<i class="fas fa-shield-alt"></i> ${trans.badge_control}`;
            
            // Update stats
            const stats = document.querySelectorAll('.stat-card');
            if (stats[0]) {
                stats[0].querySelector('h3').textContent = trans.stat1_value;
                stats[0].querySelector('p').textContent = trans.stat1_text;
            }
            if (stats[1]) {
                stats[1].querySelector('h3').textContent = trans.stat2_value;
                stats[1].querySelector('p').textContent = trans.stat2_text;
            }
            
            // Update section headers
            const featuresTitle = document.querySelector('#features .section-header h2');
            if (featuresTitle) featuresTitle.innerHTML = trans.features_title;
            
            const featuresSubtitle = document.querySelector('#features .section-header p');
            if (featuresSubtitle) featuresSubtitle.textContent = trans.features_subtitle;
            
            const techTitle = document.querySelector('#technology .section-header h2');
            if (techTitle) techTitle.innerHTML = trans.tech_title;
            
            const techSubtitle = document.querySelector('#technology .section-header p');
            if (techSubtitle) techSubtitle.textContent = trans.tech_subtitle;
            
            // Update feature cards
            const featureCards = document.querySelectorAll('.feature-card');
            featureCards.forEach((card, index) => {
                const titleKey = `feature${index + 1}_title`;
                const textKey = `feature${index + 1}_text`;
                const h3 = card.querySelector('h3');
                const p = card.querySelector('p');
                if (h3 && trans[titleKey]) h3.textContent = trans[titleKey];
                if (p && trans[textKey]) p.textContent = trans[textKey];
            });
            
            // Update tech cards
            const techCards = document.querySelectorAll('.tech-card');
            techCards.forEach((card, index) => {
                const titleKey = `tech${index + 1}_title`;
                const textKey = `tech${index + 1}_text`;
                const h3 = card.querySelector('h3');
                const p = card.querySelector('p');
                if (h3 && trans[titleKey]) h3.textContent = trans[titleKey];
                if (p && trans[textKey]) p.textContent = trans[textKey];
            });
            
            // Update CTA section
            const ctaTitle = document.querySelector('.cta-content h2');
            if (ctaTitle) ctaTitle.innerHTML = trans.cta_title;
            
            const ctaText = document.querySelector('.cta-content p');
            if (ctaText) ctaText.textContent = trans.cta_text;
            
            // Store selected language
            localStorage.setItem('selectedLanguage', lang);
            
            // Close dropdown
            document.getElementById('langDropdown').style.display = 'none';
        }

        // Language dropdown toggle
        const langBtn = document.getElementById('langBtn');
        const langDropdown = document.getElementById('langDropdown');

        langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langDropdown.style.display = langDropdown.style.display === 'none' ? 'block' : 'none';
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', () => {
            langDropdown.style.display = 'none';
        });

        // Language option click handlers
        document.querySelectorAll('.lang-option').forEach(option => {
            option.addEventListener('click', (e) => {
                e.stopPropagation();
                const lang = option.getAttribute('data-lang');
                changeLanguage(lang);
            });
            
            // Hover effect
            option.addEventListener('mouseenter', () => {
                option.style.background = 'var(--gray-100)';
            });
            option.addEventListener('mouseleave', () => {
                option.style.background = 'transparent';
            });
        });

        // Initialize AOS
        AOS.init({
            duration: 1000,
            once: false,
            offset: 100,
            easing: 'ease-out-cubic',
            mirror: true
        });

        // Initialize language on page load
        window.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('selectedLanguage');
            const initialLang = savedLang || detectLanguage();
            changeLanguage(initialLang);
        });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Navbar scroll effect
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
